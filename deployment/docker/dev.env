ENV=development

HERMES_PORT=3000
THESAURUS_URL=http://thesaurus:8001
SOPHIA_URL=http://sophia:8002
LOGOS_URL=http://logos:8003

THESAURUS_PORT=8001
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=devpass
DB_NAME=localfinance
DB_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=dev-jwt-secret-do-not-use-in-production

SOPHIA_PORT=8002
OLLAMA_HOST=http://host.docker.internal:11434
# MODEL_NAME=auto picks the best model installed on the host's Ollama at startup.
# Override with a specific tag (e.g. llama3.1:8b) to pin.
MODEL_NAME=auto

LOGOS_PORT=8003
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=devpassword
STORAGE_BUCKET=documents

IRIS_PORT=3001
