[Unit]
Description=LocalFinance Hermes (API Gateway)
After=network.target

[Service]
Type=simple
User=sagar
WorkingDirectory=/home/sagar/localfinance
ExecStart=/home/sagar/localfinance/bin/hermes
EnvironmentFile=/home/sagar/localfinance/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
