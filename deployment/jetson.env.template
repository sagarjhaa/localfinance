# LocalFinance - Jetson Environment Configuration
# Copy to /home/sagar/localfinance/.env and edit values

# ─── General ────────────────────────────────────────────
ENV=production

# ─── Hermes (API Gateway) ──────────────────────────────
HERMES_PORT=3000
THESAURUS_URL=http://127.0.0.1:8001
SOPHIA_URL=http://127.0.0.1:8002
LOGOS_URL=http://127.0.0.1:8003

# ─── Thesaurus (Database) ──────────────────────────────
THESAURUS_PORT=8001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=localfinance
DB_SSLMODE=disable
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Sophia (AI) ───────────────────────────────────────
SOPHIA_PORT=8002
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_NAME=llama3.2:1b

# ─── Logos (Document Processing) ───────────────────────
LOGOS_PORT=8003
STORAGE_ENDPOINT=127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=changeme
STORAGE_BUCKET=documents

# ─── Iris (Web Dashboard) ──────────────────────────────
IRIS_PORT=3001
JWT_SECRET=changeme-generate-a-real-secret
